<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      App discovery uses the LauncherApps system service; this <queries> block is what
      lets the launcher see packages that expose a MAIN/LAUNCHER activity on API 30+.
      QUERY_ALL_PACKAGES is deliberately NOT used.

      Optional permissions, each requested only when its feature is used:
      - SET_WALLPAPER (normal, auto-granted): direct apply of bundled templates.
        The system picker fallback needs no permission.
      - READ_CALENDAR (runtime): Upcoming / Calendar agenda. Asked only when the user
        opens a calendar feature, never at startup. All calendar use is read-only and offline.
      - PACKAGE_USAGE_STATS (special access): optional local usage summary, numbers
        only. Granted only in system Settings (Usage Access page), never requested
        in-app, revocable there at any time. No enforcement is built on it.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ZendoLauncher"
        tools:targetApi="33">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.ZendoLauncher"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
