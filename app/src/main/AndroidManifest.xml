<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      App discovery uses the LauncherApps system service; this <queries> block is what
      lets the launcher see packages that expose a MAIN/LAUNCHER activity on API 30+.
      QUERY_ALL_PACKAGES is deliberately NOT used.

      READ_CALENDAR (runtime): the optional Plan page agenda and Home calendar glance.
      Asked only when the user opens a calendar feature, never at startup; all calendar
      use is read-only and offline.

      PACKAGE_USAGE_STATS (special access, optional): powers today's screen-usage summary
      and the real-time context mirror inside the Mindful Gate. Strictly opt-in via
      system Usage Access settings.

      POST_NOTIFICATIONS (runtime, Android 13+): used only if the user picks a session
      timebox reminder in the Mindful Gate. Still no INTERNET permission anywhere.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.calendar" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ZendoLauncher"
        tools:targetApi="33">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.ZendoLauncher"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".platform.SessionReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
